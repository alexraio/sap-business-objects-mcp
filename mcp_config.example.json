{
  "mcpServers": {
    "sap-business-objects-local": {
      "command": "uv",
      "args": [
        "--directory",
        "/path/to/BO_MCP",
        "run",
        "python",
        "server.py"
      ],
      "env": {}
    },
    "sap-business-objects-remote-bridge": {
      "command": "uv",
      "args": [
        "--directory",
        "/path/to/BO_MCP",
        "run",
        "python",
        "deploy/client_bridge.py",
        "--remote-url",
        "http://your-bo-host:8000"
      ],
      "env": {}
    },
    "sap-business-objects-remote-direct": {
      "url": "http://your-bo-host:8000/mcp"
    }
  }
}
