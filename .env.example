# =============================================================================
# 1. SAP BusinessObjects REST API Configuration
# =============================================================================
# When co-located on the SAP BO host, use localhost for zero network latency:
SAP_BO_REST_API_URL="http://localhost:6405/biprws"

# Local STDIO Fallback Credentials (ignored for unauthenticated remote HTTP/SSE sessions)
SAP_BO_USERNAME="Administrator"
SAP_BO_PASSWORD="your_password_here"
SAP_BO_AUTH_TYPE="secEnterprise"

# Comma-separated SAP BO UserGroups granted access to Admin-only tools (LogService & AuditService)
SAP_BO_ADMIN_GROUPS="Administrators"

# =============================================================================
# 2. Remote MCP Transport Configuration (Streamable HTTP / SSE)
# =============================================================================
MCP_TRANSPORT="stdio"          # Options: stdio | streamable-http | sse
MCP_HOST="0.0.0.0"
MCP_PORT="8000"

# Optional HTTPS (TLS). Set BOTH to serve https:// instead of plain http://.
# Leave empty for plain HTTP (development / trusted networks / TLS-terminating reverse proxy).
# Dev cert: uv run python deploy/generate_dev_cert.py --host <bo-host>
MCP_SSL_CERTFILE=""
MCP_SSL_KEYFILE=""
MCP_SSL_KEYFILE_PASSWORD=""    # only if the private key is passphrase-protected

# =============================================================================
# 3. Local SAP BusinessObjects Server Log Directory (Admin-Only)
# =============================================================================
# Linux default: /opt/bobj/sap_bobj/logging
# Windows default: C:\Program Files (x86)\SAP BusinessObjects\SAP BusinessObjects Enterprise XI 4.0\logging
SAP_BO_LOG_DIR="/opt/bobj/sap_bobj/logging"

# =============================================================================
# 4. SAP BusinessObjects Auditing Database ODBC Configuration (Admin-Only)
# =============================================================================
# Reuse the System DSN configured in /opt/bobj/sap_bobj/enterprise_xi40/odbc.ini (Linux)
# or Windows ODBC Data Source Administrator:
SAP_BO_AUDIT_DSN="BI4_Audit_DSN"
SAP_BO_AUDIT_USER="dba"
SAP_BO_AUDIT_PASSWORD="your_audit_db_password"
SAP_BO_AUDIT_TIMEOUT="20"
# Optional full ODBC connection string override:
# SAP_BO_AUDIT_CONNECTION_STRING=""
